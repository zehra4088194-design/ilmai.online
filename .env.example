# ===== Public (inlined at BUILD time – mark as "Build Variable" in Coolify) =====
NEXT_PUBLIC_SITE_URL=https://ilmai.online
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key

# ===== Server-only secrets (NEVER prefix with NEXT_PUBLIC_) =====
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key
OPENROUTER_API_KEY=sk-or-v1-...

# Comma separated emails that are always admins (in addition to profiles.role = 'admin')
ADMIN_EMAILS=you@example.com

# Protects /api/cron/* (generate with: openssl rand -hex 32)
CRON_SECRET=change-me

# ===== Private Cloudflare AI Router (server-only) =====
AI_ROUTER_URL=https://ilmai-ai-router.<your-account>.workers.dev
AI_ROUTER_SECRET=replace-with-the-same-random-secret-used-by-the-worker

# ===== Private PDF renderer (Coolify internal network only) =====
PDF_RENDERER_URL=http://pdf-renderer:3400
PDF_RENDERER_SECRET=replace-with-the-same-random-secret-on-both-services

# ===== Backblaze B2 (S3-compatible) =====
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=004xxxxxxxxxxxx0000000001
B2_APPLICATION_KEY=K004xxxxxxxxxxxxxxxxxxxxxxxxxxx
B2_BUCKET=ilmai-media
