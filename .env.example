# Ilm AI — Coolify Environment Variables
# Paste/import these names into Coolify and fill in the values.
# NEXT_PUBLIC_* must be available as BUILD variables as well as runtime variables.

# Public build-time variables
NEXT_PUBLIC_SITE_URL=https://ilmai.online
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAGSXmRuv5Oq2B8ye # Public Cloudflare Turnstile sitekey (build + runtime)

# Cloudflare Turnstile: server-side verification for Google OAuth.
# Store the same Turnstile secret in Supabase Auth > Bot and Abuse Protection > CAPTCHA.
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=ilmai.online
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT= # sandbox or production

# Supabase server secret
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare AI Router (all provider inference, catalogue, Gamma and media transfer)
# Deployed Cloudflare Worker base URL (update if you change the Worker name/subdomain).
AI_ROUTER_URL=https://ilmai-ai-router.ilmai.workers.dev
# Must exactly match the AI_ROUTER_SECRET stored in Cloudflare Worker secrets.
AI_ROUTER_SECRET=

# Admin / scheduled task security
ADMIN_EMAILS=ilmai.store2@gmail.com
CRON_SECRET=

# Daily USD -> PKR reference rate (same ExchangeRate-API key as the old ilmAI app)
# Server-side secret only. The existing daily-credits cron refreshes this once a day.
EXCHANGE_RATE_API_KEY=


# E2B isolated Website Builder sandbox
E2B_API_KEY=

# Private PDF renderer service (optional until deployed)
PDF_RENDERER_URL=
PDF_RENDERER_SECRET=

# Email sending (Resend). Verify ilmai.online in Resend before using this sender.
RESEND_API_KEY=
EMAIL_FROM="Ilm AI <contact@ilmai.online>"

# Backblaze B2 storage
B2_ENDPOINT=
B2_REGION=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# Billing providers (optional; enable only when configured in Admin plans)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT= # sandbox or production
PAYPRO_MERCHANT_NO=
PAYPRO_APP_SECRET=
PAYPRO_API_BASE_URL=
PAYPRO_NOTIFY_URL=

# Public business and privacy details shown on legal pages (complete before launch)
LEGAL_ENTITY_NAME=
SUPPORT_EMAIL=contact@ilmai.online
FEEDBACK_EMAIL=feedback@ilmai.online
PRIVACY_CONTACT_EMAIL=contact@ilmai.online
LEGAL_POSTAL_ADDRESS=
LEGAL_GOVERNING_LAW=
LEGAL_DATA_REGIONS=
